{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "paths": {
      "prismui-core": [
        "./packages/prismui-core/src/index.tsx"
      ],
      "prismui-core/lib/*": [
        "./packages/prismui-core/src/*"
      ],
      "prismui-formula": [
        "./packages/prismui-formula/src/index.ts"
      ],
      "prismui-formula/lib/*": [
        "./packages/prismui-formula/src/*"
      ],
      "prismui-ui": [
        "./packages/prismui-ui/src/index.tsx"
      ],
      "prismui-ui/lib/*": [
        "./packages/prismui-ui/src/*"
      ],
      "prismui": [
        "./packages/prismui-framework/src/index.tsx"
      ],
      "prismui/lib/*": [
        "./packages/prismui-framework/src/*"
      ],
      "prismui-framework": [
        "./packages/prismui-framework/src/index.tsx"
      ],
      "prismui-framework/lib/*": [
        "./packages/prismui-framework/src/*"
      ],
      "prismui-i18n-runtime": [
        "./packages/prismui-i18n-runtime/lib/index.d.ts"
      ],
      "prismui-office-viewer": [
        "./packages/prismui-office-viewer/src/index.ts"
      ],
      "prismui-office-viewer/lib/*": [
        "./packages/prismui-office-viewer/src/*"
      ],
      "prismui-editor-core": [
        "./packages/prismui-editor-core/src/index.ts"
      ],
      "prismui-editor-core/lib/*": [
        "./packages/prismui-editor-core/src/*"
      ],
      "packages/prismui-editor-core/lib": [
        "./packages/prismui-editor-core/src/index.ts"
      ],
      "prismui-editor": [
        "./packages/prismui-editor/src/index.tsx"
      ],
      "prismui-editor/lib/*": [
        "./packages/prismui-editor/src/*"
      ],
      "prismui-theme-editor-helper": [
        "./packages/prismui-theme-editor-helper/src/index.ts"
      ],
      "prismui-theme-editor-helper/lib/*": [
        "./packages/prismui-theme-editor-helper/src/*"
      ]
    }
  },
  "exclude": [
    "node_modules/**/*",
    "lib/**/*",
    "dist/**/*",
    "esm/**/*"
  ]
}
