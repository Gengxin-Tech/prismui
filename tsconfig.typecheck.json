{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "paths": {
      "prismui-core": [
        "./packages/amis-core/src/index.tsx"
      ],
      "prismui-core/lib/*": [
        "./packages/amis-core/src/*"
      ],
      "prismui-formula": [
        "./packages/amis-formula/src/index.ts"
      ],
      "prismui-formula/lib/*": [
        "./packages/amis-formula/src/*"
      ],
      "prismui-ui": [
        "./packages/amis-ui/src/index.tsx"
      ],
      "prismui-ui/lib/*": [
        "./packages/amis-ui/src/*"
      ],
      "prismui": [
        "./packages/amis/src/index.tsx"
      ],
      "prismui/lib/*": [
        "./packages/amis/src/*"
      ],
      "prismui-framework": [
        "./packages/amis/src/index.tsx"
      ],
      "prismui-framework/lib/*": [
        "./packages/amis/src/*"
      ],
      "prismui-i18n-runtime": [
        "./packages/prismui-i18n-runtime/es/index.js"
      ],
      "prismui-office-viewer": [
        "./packages/office-viewer/src/index.ts"
      ],
      "prismui-office-viewer/lib/*": [
        "./packages/office-viewer/src/*"
      ],
      "prismui-editor-core": [
        "./packages/amis-editor-core/src/index.ts"
      ],
      "prismui-editor-core/lib/*": [
        "./packages/amis-editor-core/src/*"
      ],
      "packages/amis-editor-core/lib": [
        "./packages/amis-editor-core/src/index.ts"
      ],
      "prismui-editor": [
        "./packages/amis-editor/src/index.tsx"
      ],
      "prismui-editor/lib/*": [
        "./packages/amis-editor/src/*"
      ],
      "prismui-theme-editor-helper": [
        "./packages/amis-theme-editor-helper/src/index.ts"
      ],
      "prismui-theme-editor-helper/lib/*": [
        "./packages/amis-theme-editor-helper/src/*"
      ]
    }
  },
  "exclude": [
    "node_modules/**/*",
    "lib/**/*",
    "dist/**/*",
    "esm/**/*"
  ]
}
